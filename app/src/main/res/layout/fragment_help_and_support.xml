<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.detail.HelpAndSupportFragment"
    android:background="@color/white"
    android:layout_margin="20dp">

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="match_parent">
       <Toolbar
           android:id="@+id/toolBar"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:gravity="center_vertical"
           android:layout_marginTop="15dp"
           >
           <ImageButton
               android:layout_width="60dp"
               android:layout_height="60dp"
               android:src="@drawable/outline_arrow_left_alt_24"
               android:layout_gravity="center|start"
               android:scaleType="centerCrop"
               android:backgroundTint="@color/white" />

           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Bağcılar Municipality"
               android:textSize="25sp"
               android:fontFamily="@font/poppins_semibold"
               android:textColor="@color/bagcilar_dark_blue"
               android:layout_gravity="center_horizontal" />
       </Toolbar>

       <TextView
           android:id="@+id/tvTitle"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Help And Support"
           android:fontFamily="@font/poppins_semibold"
           android:textSize="22sp"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@id/toolBar"
           android:layout_marginTop="10dp"/>

       <TextView
           android:id="@+id/tvDesc"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Choose how app looks"
           android:fontFamily="@font/poppins"
           android:textSize="12sp"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintTop_toBottomOf="@id/tvTitle"/>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cvAskAi"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/bagcilar_dark_blue"
           app:cardElevation="4dp"
           app:cardCornerRadius="18dp"
           app:layout_constraintTop_toBottomOf="@id/tvDesc"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:layout_marginTop="10dp">
           <LinearLayout
               android:id="@+id/linearLayout"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="horizontal"
               android:padding="10dp"
               android:layout_marginTop="10dp">
               <com.google.android.material.imageview.ShapeableImageView
                   android:layout_width="60dp"
                   android:layout_height="60dp"
                   android:src="@drawable/bagcilar_ai_badge"
                   />
               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="vertical"
                   android:layout_gravity="center_vertical"
                   android:layout_marginStart="10dp"
                   android:layout_weight="1">
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Ask AI Assistant"
                       android:textSize="18sp"
                       android:textColor="@color/white"
                       android:fontFamily="@font/poppins_semibold"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Get instant, intelligent answers"
                       android:fontFamily="@font/poppins"
                       android:textSize="12sp"
                       android:textColor="@color/white"
                       app:layout_constraintStart_toStartOf="parent"
                       app:layout_constraintTop_toBottomOf="@id/tvTitle"/>
               </LinearLayout>

               <ImageView
                   android:layout_width="30dp"
                   android:layout_height="30dp"
                   android:src="@drawable/outline_chevron_forward_24"
                   android:tint="@color/white"
                   android:layout_gravity="center_vertical"/>
           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>

       <TextView
           android:id="@+id/tvFaq"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="FREQUENTLY ASKED"
           android:textSize="15sp"
           android:fontFamily="@font/poppins_medium"
           android:layout_marginTop="20dp"
           app:layout_constraintTop_toBottomOf="@id/cvAskAi"
           app:layout_constraintStart_toStartOf="parent"/>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cvHowReport"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/white"
           app:cardElevation="4dp"
           app:cardCornerRadius="10dp"
           app:layout_constraintTop_toBottomOf="@id/tvFaq"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:layout_marginTop="10dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <LinearLayout
                   android:id="@+id/faqReportHeader"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:padding="10dp"
                   android:gravity="center_vertical">
                   <ImageView
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/outline_info_24"
                       android:layout_marginEnd="10dp"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="How do I report a problem?"
                       android:textSize="14sp"
                       android:fontFamily="@font/poppins"
                       android:layout_weight="1"/>

                   <ImageView
                       android:id="@+id/ivFaqReportArrow"
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/outline_chevron_forward_24"
                       app:tint="@color/bagcilar_dark_blue" />
               </LinearLayout>

               <TextView
                   android:id="@+id/tvFaqReportAnswer"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:fontFamily="@font/poppins"
                   android:paddingStart="50dp"
                   android:paddingEnd="20dp"
                   android:paddingBottom="16dp"
                   android:text="To report a problem, tap Report from the bottom menu, select a category, add a description and photos, choose the location, and submit your report."
                   android:textColor="@color/text_secondary"
                   android:textSize="14sp"
                   android:visibility="gone" />
           </LinearLayout>
       </com.google.android.material.card.MaterialCardView>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cvHowLocation"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/white"
           app:cardElevation="4dp"
           app:cardCornerRadius="10dp"
           app:layout_constraintTop_toBottomOf="@id/cvHowReport"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:layout_marginTop="10dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <LinearLayout
                   android:id="@+id/faqLocationHeader"
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:orientation="horizontal"
                   android:padding="10dp"
                   android:gravity="center_vertical">
                   <ImageView
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/outline_location_on_24"
                       android:layout_marginEnd="10dp"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="How does location work?"
                       android:textSize="14sp"
                       android:fontFamily="@font/poppins"
                       android:layout_weight="1"/>

                   <ImageView
                       android:id="@+id/ivFaqLocationArrow"
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/outline_chevron_forward_24"
                       app:tint="@color/bagcilar_dark_blue" />
               </LinearLayout>
               <TextView
                   android:id="@+id/tvFaqLocationAnswer"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="You can select the location of the problem directly on the map. This helps the municipality identify where the issue is located."
                   android:paddingStart="50dp"
                   android:paddingEnd="20dp"
                   android:paddingBottom="16dp"
                   android:textColor="@color/text_secondary"
                   android:fontFamily="@font/poppins"
                   android:textSize="14sp"
                   android:visibility="gone"/>
           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cvHowPhoto"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="@color/white"
           app:cardElevation="4dp"
           app:cardCornerRadius="10dp"
           app:layout_constraintTop_toBottomOf="@id/cvHowLocation"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           android:layout_marginTop="10dp">
           <LinearLayout
               android:id="@+id/faqPhotoHeader"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="match_parent"
                   android:orientation="horizontal"
                   android:padding="10dp"
                   android:gravity="center_vertical">
                   <ImageView
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/ic_bagcilar_add_photo"
                       android:layout_marginEnd="10dp"/>
                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="Can I add photos to my report?"
                       android:textSize="14sp"
                       android:fontFamily="@font/poppins"
                       android:layout_weight="1"/>

                   <ImageView
                       android:id="@+id/ivFaqPhotoArrow"
                       android:layout_width="30dp"
                       android:layout_height="30dp"
                       android:src="@drawable/outline_chevron_forward_24"
                       app:tint="@color/bagcilar_dark_blue" />
               </LinearLayout>
               <TextView
                   android:id="@+id/tvFaqPhotoAnswer"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:paddingStart="50dp"
                   android:paddingEnd="20dp"
                   android:paddingBottom="16dp"
                   android:text="Yes. You can add multiple photos while creating a report. Photos help our municipal team better understand the problem."
                   android:fontFamily="@font/poppins"
                   android:textSize="14sp"
                   android:textColor="@color/text_secondary"
                   android:visibility="gone"/>
           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/cvNeedHelp"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           app:cardBackgroundColor="#F2F3F9"
           app:cardElevation="4dp"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintTop_toBottomOf="@id/cvHowPhoto"
           app:layout_constraintBottom_toBottomOf="parent"
           android:layout_marginTop="40dp"
           app:cardCornerRadius="18dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:gravity="center"
               android:padding="10dp">
               <com.google.android.material.imageview.ShapeableImageView
                   android:layout_width="60dp"
                   android:layout_height="60dp"
                   android:scaleType="centerCrop"
                   android:src="@drawable/baseline_local_phone_24"
                   android:background="@drawable/bg_icon"
                   app:shapeAppearance="@style/CircleImageView"
                   android:elevation="4dp"
                   android:padding="10dp"/>

               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Still need help?"
                   android:fontFamily="@font/poppins_semibold"
                   android:textSize="22sp"/>

               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Can't find your answer? \nOur municipal team is here to help."
                   android:textAlignment="center"
                   android:fontFamily="@font/poppins"
                   android:textSize="14sp"/>

               <com.google.android.material.button.MaterialButton
                   android:id="@+id/btnContact"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="Contact Municipality"
                   android:fontFamily="@font/poppins_semibold"
                   app:icon="@drawable/baseline_local_phone_24"
                   app:iconGravity="textStart"
                   android:backgroundTint="@color/bagcilar_dark_blue"
                   android:layout_marginStart="20dp"
                   android:layout_marginEnd="20dp"
                   android:layout_marginBottom="10dp"/>
           </LinearLayout>
       </com.google.android.material.card.MaterialCardView>
   </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.core.widget.NestedScrollView>