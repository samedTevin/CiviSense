<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:orientation="vertical"
android:gravity="center|top"
tools:context=".ui.onboarding.WelcomeFragment"
android:layout_margin="20dp">

<ImageButton
    android:id="@+id/ibBackToLogin"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_gravity="start"
    android:layout_marginBottom="30dp"
    android:scaleType="fitCenter"
    android:src="@drawable/outline_arrow_left_alt_24"
    android:backgroundTint="@color/white"/>

<ImageView
    android:layout_width="200dp"
    android:layout_height="200dp"
    />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Welcome"
    android:fontFamily="@font/poppins_bold"
    android:textSize="35sp"
    android:textColor="@color/bagcilar_dark_blue"
    android:layout_marginTop="20dp"/>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Enter your email address and we'll send you a link to reset your password."
    android:textSize="18sp"
    android:fontFamily="@font/poppins_medium"
    android:textAlignment="center"/>

<com.google.android.material.textfield.TextInputLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="@string/email_adress"
    app:boxBackgroundMode="outline"
    app:boxStrokeColor="@color/bagcilar_dark_blue"
    app:boxStrokeWidth="3dp"
    app:hintTextColor="@color/bagcilar_dark_blue"
    app:startIconDrawable="@drawable/baseline_mail_outline_24"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="20dp">
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:textColor="@color/black"
        android:inputType="textEmailAddress"/>
</com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.button.MaterialButton
    android:id="@+id/btnSendResetLink"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bagcilar_dark_blue"
    android:text="Send Reset Link"
    android:textSize="20sp"
    android:fontFamily="@font/poppins_semibold"
    app:iconGravity="textEnd"
    app:icon="@drawable/outline_arrow_right_alt_24"
    app:cornerRadius="4dp"
    app:strokeColor="@color/bagcilar_light_blue"
    app:strokeWidth="3dp"
    android:elevation="4dp"
    android:layout_marginTop="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginStart="20dp"/>

<TextView
    android:id="@+id/tvBackToLogIn"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Back to Log in"
    android:drawableStart="@drawable/outline_arrow_left_alt_24"
    android:textSize="15sp"
    android:fontFamily="@font/poppins_semibold"
    android:layout_marginTop="20dp"
    android:padding="8dp"/>

</LinearLayout>