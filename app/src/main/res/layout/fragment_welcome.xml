<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:orientation="vertical"
android:gravity="center"
tools:context=".ui.onboarding.WelcomeFragment"
android:layout_margin="20dp">



<ImageView
    android:layout_width="200dp"
    android:layout_height="200dp"
    android:src="@drawable/ic_welcome"
    />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/bagcilar_municipality"
    android:textAlignment="center"
    android:fontFamily="@font/poppins_bold"
    android:textSize="35sp"
    android:textColor="@color/bagcilar_dark_blue"
    android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/civisense"
        android:textAlignment="center"
        android:fontFamily="@font/poppins_bold"
        android:textSize="25sp"
        android:textColor="@color/bagcilar_light_blue"
        android:layout_marginTop="10dp"/>


<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/welcome_desc"
    android:textSize="18sp"
    android:fontFamily="@font/poppins_medium"
    android:textAlignment="center"
    android:layout_marginBottom="20dp"/>


<com.google.android.material.button.MaterialButton
    android:id="@+id/btnLogIn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/bagcilar_dark_blue"
    android:text="@string/log_in"
    android:textSize="20sp"
    android:fontFamily="@font/poppins_semibold"
    app:iconGravity="textEnd"
    app:icon="@drawable/outline_arrow_right_alt_24"
    app:cornerRadius="4dp"
    app:strokeColor="@color/bagcilar_light_blue"
    app:strokeWidth="3dp"
    android:elevation="4dp"
    android:layout_marginTop="40dp"
    android:layout_marginEnd="20dp"
    android:layout_marginStart="20dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/bagcilar_light_blue"
        android:text="@string/create_account"
        android:textSize="20sp"
        android:fontFamily="@font/poppins_semibold"
        app:iconGravity="textEnd"
        app:icon="@drawable/outline_account_circle_24"
        app:cornerRadius="4dp"
        app:strokeColor="@color/bagcilar_dark_blue"
        app:strokeWidth="3dp"
        android:elevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"/>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        />

    <TextView
        android:id="@+id/tvContinueAsGuest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/continue_as_guest"
        android:fontFamily="@font/poppins_medium"
        android:textSize="15sp" />


</LinearLayout>