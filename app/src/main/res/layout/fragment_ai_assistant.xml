<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".ui.onboarding.viewpager.ReportIssueFragment"
    android:layout_margin="20dp"
    android:background="@color/white">

    <ImageView
        android:id="@+id/ivReportLogo"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_onboarding_ai"
        android:backgroundTint="@color/white"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_smart_assistant"
        android:textAlignment="center"
        android:textColor="@color/bagcilar_dark_blue"
        android:textSize="40sp"
        android:fontFamily="@font/poppins_bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_smart_assistant_description"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:fontFamily="@font/poppins"
        android:textSize="20sp"
        android:layout_marginTop="5dp"/>

</LinearLayout>